{
  "name": "construccion-demos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:check": "tsx scripts/seed-check.ts",
    "flujos:check": "tsx scripts/flujos-check.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && tsx prisma/seed.ts && next build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "db:seed:ejemplo": "tsx --env-file-if-exists=.env.local prisma/seed-ejemplo.ts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/db-check.ts",
    "db:studio": "bash -c 'set -a && . ./.env.local && prisma studio'",
    "db:test:mapeo": "tsx --env-file-if-exists=.env.local scripts/db-mapeo-check.ts",
    "db:test:concurrencia": "tsx --env-file-if-exists=.env.local scripts/concurrencia-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "db:seed:carga": "tsx scripts/seed-carga.ts",
    "db:rendimiento": "tsx scripts/rendimiento.ts",
    "db:rendimiento:estado": "tsx scripts/rendimiento-estado.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "sentry:prueba": "tsx scripts/sentry-prueba.ts",
    "arca:csr": "tsx scripts/arca-csr.ts",
    "padron:probar": "tsx scripts/padron-probar.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^11.6.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "nanoid": "^6.0.2",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "node-forge": "^1.4.0",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sentry/node": "^11.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
